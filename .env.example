# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
DEV_PORT=8080
SPRING_PROFILES_ACTIVE=dev
GITHUB_REPOSITORY_OWNER=your-github-username-or-org
BACKEND_IP=127.0.0.1

# ==============================================================================
# DATABASE (POSTGRES)
# ==============================================================================
POSTGRES_DB=travery-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_EXTERNAL_PORT=6379

# ==============================================================================
# EMAIL (SMTP GMAIL)
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET=your_super_long_and_secret_jwt_key_here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

OTP_TTL_MINUTES=5
MAX_ATTEMPTS=3
RESEND_COOLDOWN_SECONDS=60
RESET_MAX_PER_HOUR=5
OTP_LENGTH=6

# ==============================================================================
# CLOUDINARY CONFIGURATION
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_DEFAULT_AVATAR_URL=https://res.cloudinary.com/demo/image/upload/v1/default-avatar.png
CLOUDINARY_ALLOWED_IMAGE_TYPES=jpg,png,jpeg,webp
CLOUDINARY_ALLOWED_VIDEO_TYPES=mp4,mov
CLOUDINARY_AVATAR_SIZE=200
CLOUDINARY_THUMBNAIL_SIZE=400
CLOUDINARY_POST_IMAGE_WIDTH=1200
CLOUDINARY_POST_IMAGE_HEIGHT=800

# ==============================================================================
# FILE UPLOAD LIMITS
# ==============================================================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB
POST_LIMIT_UPLOAD_IMAGES=10
POST_LIMIT_UPLOAD_VIDEOS=1

# ==============================================================================
# THREAD POOL CONFIGURATION
# ==============================================================================
CORE_THREAD_POOL_SIZE=5
MAX_THREAD_POOL_SIZE=10
THREAD_QUEUE_CAPACITY=100

# ==============================================================================
# API DOCUMENTATION (SCALAR / SWAGGER)
# ==============================================================================
SCALAR_ENABLED=true
SCALAR_PATH=/docs
SCALAR_URL=/v3/api-docs

# ==============================================================================
# OBSERVABILITY & MONITORING (PROD)
# ==============================================================================
PROMETHEUS_HOST=your_prometheus_ip
LOKI_HOST=your_loki_ip

# ==============================================================================
# VNPAY INTEGRATION
# ==============================================================================
VNPAY_TERMINAL_ID=your_vnpay_terminal_id
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_INIT_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_IPN_URL=https://your-domain.com/api/v1/payments/vnpay-ipn
VNPAY_RETURN_URL=https://your-domain.com/api/v1/payments/vnpay-return
VNPAY_DEEPLINK_SCHEME=travery://payment-result
VNPAY_TIMEOUT=15

# ==============================================================================
# COMETCHAT INTEGRATION
# ==============================================================================
COMETCHAT_APP_ID=your_app_id
COMETCHAT_API_KEY=your_api_key
COMETCHAT_REGION=in
COMETCHAT_AUTH_KEY=your_auth_key

# ==============================================================================
# FIREBASE CONFIGURATION
# ==============================================================================
FIREBASE_CONFIG_PATH=path-to-your-firebase-adminsdk.json
FIREBASE_APP_NAME=Travery-Backend